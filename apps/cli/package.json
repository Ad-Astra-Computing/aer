{
  "name": "@adastracomputing/aer",
  "version": "0.3.0",
  "description": "AER command line: wire auto-instrumentation into a project, ingest and import agent runs, and independently verify signed execution records",
  "type": "module",
  "private": false,
  "bin": {
    "aer": "./dist/main.js"
  },
  "files": [
    "dist/main.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "Ad Astra Computing",
  "homepage": "https://aer.run",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ad-Astra-Computing/aer.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/Ad-Astra-Computing/aer/issues"
  },
  "keywords": [
    "aer",
    "agent",
    "cli",
    "auto-instrumentation",
    "signed-execution-record",
    "verify"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "prebuild": "node scripts/write-version.mjs",
    "build": "rm -rf dist && node bundle.mjs",
    "pretest": "node scripts/write-version.mjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/write-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../scripts/require-dist.mjs"
  },
  "devDependencies": {
    "@adastracomputing/aer-auto-node": "workspace:*",
    "@adastracomputing/aer-hooks": "workspace:*",
    "@adastracomputing/aer-verify": "workspace:*",
    "@aer/schemas": "workspace:*",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.0",
    "msw": "^2.7.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
