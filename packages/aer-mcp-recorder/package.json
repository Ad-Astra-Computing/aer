{
  "name": "@adastracomputing/aer-mcp-recorder",
  "version": "0.3.1",
  "description": "Transparent MCP proxy that records the tool activity a coding harness drives through MCP, with no harness integration. Fail-open byte transparency and redaction by default.",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    }
  },
  "bin": {
    "aer-mcp-recorder": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "Ad Astra Computing",
  "homepage": "https://aer.run",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ad-Astra-Computing/aer.git",
    "directory": "packages/aer-mcp-recorder"
  },
  "bugs": {
    "url": "https://github.com/Ad-Astra-Computing/aer/issues"
  },
  "keywords": [
    "aer",
    "agent",
    "mcp",
    "model-context-protocol",
    "proxy",
    "observability"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@adastracomputing/aer-emit": "workspace:*"
  },
  "scripts": {
    "prebuild": "node scripts/write-version.mjs",
    "build": "tsc -p tsconfig.json",
    "pretest": "node scripts/write-version.mjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/write-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../scripts/require-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
