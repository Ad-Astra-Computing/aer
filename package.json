{
  "name": "aer",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "typecheck": "node scripts/check-vendored.mjs && pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/write-versions.mjs",
    "release": "pnpm -r build && changeset publish --tag next",
    "promote": "node scripts/promote-latest.mjs",
    "check:vendored": "node scripts/check-vendored.mjs",
    "matrix": "node scripts/matrix/run.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@changesets/cli": "^3.0.1",
    "@changesets/changelog-github": "^1.0.0"
  }
}
